---
import ControlSymbol from './ControlSymbol.astro';
const { rows = [], globals = [], language = 0, firstStep = false } = Astro.props;
const controls = [
  {id:'trigger',label:'Trigger / Reset',kind:'locator-switch'},
  {id:'pitch',label:'1 · Pitch',kind:'locator-knob'},
  {id:'transpose',label:'↑ / ↓ Transpose',kind:'locator-switch'},
  {id:'velocity',label:'2 · Velocity',kind:'locator-knob'},
  {id:'xfader',label:'3 · Xfader',kind:'locator-knob'},
  {id:'io',label:'4 · I/O',kind:'locator-switch'}
];
const globalControls = [
  {name:'Clock',up:'Note',down:'16th',middle:'var.'},
  {name:'Scale',up:'program',down:'chromatic'},
  {name:'Option',up:'A',down:'B'},
  {name:'M.Ch.',up:'run',down:'reset'},
  {name:'Cont.',up:'Row3',down:'Row4'},
  {name:'Transp.',up:'up',down:'down'},
  {name:'Encoder',up:'off · 1–15',down:''}
];
---
<figure class="panel-locator">
  <figcaption>{language === 0 ? 'Bedienelemente' : 'Controls'} <span>{language === 0 ? 'Vorderansicht · relevante Reihen hervorgehoben' : 'Front view · relevant rows highlighted'}</span></figcaption>
  <div class="panel-body" aria-hidden="true">
    <div class="panel-grid panel-numbers"><span>{language === 0 ? 'Schritt →' : 'Step →'}</span>{Array.from({length:16},(_,i)=><span>{i+1}</span>)}</div>
    {controls.map(control=><div class:list={['panel-grid',control.kind === 'locator-knob' ? 'tone-knob' : 'tone-step',{'row-highlight':rows.includes(control.id)}]}>
      <span class="panel-row-label">{control.label}</span>
      {Array.from({length:16},(_,i)=><span class:list={['panel-cell',{'target-control':rows.includes(control.id) && (!firstStep || i===0)}]}><ControlSymbol kind={control.kind === 'locator-knob' ? 'knob' : 'switch'}/></span>)}
    </div>)}
    {(rows.includes('pitch') || rows.includes('velocity')) && <div class="connection-map">
      <strong>{language === 0 ? 'Vorderseite · unterste Reihe, links ↙' : 'Front panel · bottom row, left ↙'}</strong>
      <div class="connection-groups">{['pitch','velocity'].map((row,i)=><div class:list={['connection-group',{'connection-active':rows.includes(row)}]}>
        <span class="connection-name">{i+1} · {i === 0 ? 'Pitch' : 'Velocity'}</span>
        <div class="connection-item tone-knob"><ControlSymbol kind="knob"/><span>{language === 0 ? 'Add-In-Regler' : 'Add In control'}</span></div>
        <div class="connection-item tone-socket"><ControlSymbol kind="socket"/><strong>{i+1} · Add In</strong></div>
        <div class="connection-item tone-socket"><ControlSymbol kind="socket"/><strong>{i+1} · Out</strong></div>
      </div>)}</div>
      {rows.includes('pitch') && <div class="rear-connection tone-socket"><ControlSymbol kind="socket"/><div><strong>MIDI Out</strong><br/>{language === 0 ? 'Rückseite · separat von den CV-Buchsen' : 'Rear panel · separate from the CV sockets'}</div></div>}
    </div>}
    <div class="panel-global-caption">{language === 0 ? 'Globale Bedienelemente · unten rechts ↘' : 'Global controls · bottom right ↘'}</div>
    <div class="scroll-hint">{language === 0 ? '↔ Schalterreihe seitlich verschieben' : '↔ Scroll the switch row sideways'}</div>
    <div class="global-scroll"><div class="panel-globals">{globalControls.map(control=><div class:list={['global-cell',control.name === 'Encoder' ? 'tone-knob' : 'tone-global',{'target-control':globals.includes(control.name)}]}><span class="position-label">{control.up}</span><div class="switch-drawing">{control.middle && <small>{control.middle}</small>}<ControlSymbol kind={control.name === 'Encoder' ? 'knob' : 'switch'} scope="global"/></div><span class="position-label">{control.down || '\u00a0'}</span><strong>{control.name}</strong></div>)}</div></div>
  </div>
  <div class="panel-key"><span><ControlSymbol kind="knob"/> {language === 0 ? 'Drehknopf' : 'Knob'}</span><span><ControlSymbol kind="switch"/> {language === 0 ? 'Schritt-Schalter' : 'Step switch'}</span><span><ControlSymbol kind="switch" scope="global"/> {language === 0 ? 'Globaler Schalter' : 'Global switch'}</span><span><ControlSymbol kind="socket"/> {language === 0 ? 'Buchse' : 'Socket'}</span></div>
  {firstStep && <p class="panel-key">{language === 0 ? 'Zum Programmieren nur Pitch von Schritt 1 benutzen.' : 'For programming, use only the step 1 Pitch knob.'}</p>}
</figure>
<style>
  .panel-locator {margin:1.4rem 0; background:#f2f0e8; border:1px solid #d9d3c6; border-radius:10px; padding:16px; max-width:850px;}
  figcaption {font-weight:750; margin-bottom:15px; font-size:.95rem;}
  figcaption span {display:block; font-weight:400; color:#5b584e; font-size:.8rem; margin-top:4px;}
  .panel-grid {display:grid; grid-template-columns:130px repeat(16,minmax(0,1fr)); align-items:center; gap:3px; padding:4px 6px; border-radius:4px;}
  .panel-numbers {font-size:10px; color:#5b584e; text-align:center;}
  .panel-row-label {font-size:12px; font-weight:600;}
  .panel-cell {display:flex; justify-content:center; align-items:center; height:25px; border-radius:4px;}
  i {display:block; flex-shrink:0;}
  .locator-knob {width:18px; height:18px; border:2px solid #88857b; border-radius:50%; position:relative; background:#e3e0d7;}
  .locator-knob::after {content:''; position:absolute; height:5px; width:2px; background:#666; top:1px; left:6px;}
  .locator-switch {width:6px; height:15px; background:#bdb9ad; border:1px solid #8d897d; border-radius:4px;}
  .tone-knob {--control-fill:#e7f0fb;--control-edge:#3677b5;}
  .tone-step {--control-fill:#fff0da;--control-edge:#b56b18;}
  .tone-global {--control-fill:#dcf2d2;--control-edge:#478438;}
  .row-highlight {background:var(--control-fill); color:#252525;}
  .panel-cell:not(.target-control) {opacity:.28;}
  .target-control {background:var(--control-fill); outline:1px solid var(--control-edge);}
  .panel-cell :global(svg) {width:22px;height:22px;}
  .target-control .locator-knob {background:#fff; border-color:#fff;}
  .target-control .locator-switch {background:#fff; border-color:#fff;}
  .connection-map {margin-top:16px;font-size:11px;}
  .connection-groups {display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;}
  .connection-group {display:grid;grid-template-columns:repeat(3,1fr);gap:5px;border:1px solid #aaa69b;border-radius:5px;padding:7px;opacity:.4;}
  .connection-active {opacity:1;border:2px solid #66645e;}
  .connection-name {grid-column:1/-1;font-weight:750;}
  .connection-item {display:flex;flex-direction:column;align-items:center;gap:5px;padding:7px;background:var(--control-fill);border:1px solid var(--control-edge);border-radius:4px;}
  .tone-socket {--control-fill:#f5f4f0;--control-edge:#88847b;}
  .rear-connection {display:flex;align-items:center;gap:10px;border:1px dashed var(--control-edge);background:var(--control-fill);padding:8px;margin-top:10px;width:fit-content;}
  .panel-global-caption {text-align:right; font-size:11px; margin:16px 0 7px;}
  .scroll-hint {display:none;font-size:10px;color:#666158;margin-bottom:5px;}
  .global-scroll {overflow-x:auto;padding:2px;}
  .panel-globals {display:grid; grid-template-columns:repeat(7,1fr); gap:5px; margin-left:auto; width:540px;}
  .global-cell {display:flex; align-items:center; flex-direction:column; gap:4px; padding:8px 2px; border-radius:4px; font-size:11px;}
  .switch-drawing {position:relative;}
  .switch-drawing small {position:absolute;right:26px;top:7px;font-size:10px;}
  .position-label {font-size:11px;min-height:13px;}
  .panel-key {font-size:.75rem; color:#5b584e; margin:12px 0 0;display:flex;flex-wrap:wrap;gap:6px 15px;}
  .panel-key :global(svg) {width:20px;height:20px;}
  @media(max-width:640px) {
    .scroll-hint {display:block;}
    .panel-locator {padding:10px; margin-inline:-4px;}
    .panel-grid {grid-template-columns:88px repeat(16,minmax(0,1fr)); gap:1px; padding:3px 1px;}
    .panel-row-label {font-size:9px;}
    .panel-numbers {font-size:7px;}
    .panel-cell {height:20px;}
    .panel-cell :global(svg) {width:12px;height:16px;}
    .panel-cell .locator-knob {width:9px; height:9px; border-width:1px;}
    .panel-cell .locator-knob::after {height:3px; width:1px; left:3px; top:0;}
    .panel-cell .locator-switch {width:4px; height:12px;}
    .global-cell {font-size:9px;}
    .panel-globals {gap:2px;}
  }
  @media print {.panel-locator {break-inside:avoid; print-color-adjust:exact;}}
</style>
