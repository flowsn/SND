---
const timingValues = [
  { label: 'SKIP', eighths: 0 },
  { label: '1/32', eighths: 0.25 },
  { label: '1/16', eighths: 0.5 },
  { label: '1/8', eighths: 1 },
  { label: '1/4', eighths: 2 },
  { label: '1/2', eighths: 4 },
  { label: 'ALIGN', eighths: -1 }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>SND SAM-16 Online Manual</title>
    <style is:global>
      :root {
        font-family: Inter, system-ui, sans-serif;
        color: #171717;
        background: #f2f1ec;
      }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { max-width: 1380px; margin: 0 auto; padding: 36px 24px 80px; }
      h1,h2 { letter-spacing: -.025em; }
      .card {
        background: #fff;
        border: 1px solid #d7d4cb;
        border-radius: 14px;
        padding: 28px;
        margin-top: 24px;
      }
      .note { max-width: 900px; line-height: 1.55; }
      .hardware-caption {
        margin-top: 24px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .controls {
        display:flex;
        gap:28px;
        flex-wrap:wrap;
        align-items:end;
        margin-top: 20px;
      }
      .control-group { display:flex; gap:12px; align-items:end; }
      label {
        font-size: 12px;
        font-weight: 800;
        display:block;
        margin-bottom:6px;
        letter-spacing:.03em;
      }
      select, button {
        font: inherit;
        padding: 8px 10px;
        background: #f7f6f1;
        border: 1px solid #999;
      }
      button { cursor:pointer; min-width:76px; }
      button:hover { background:#eceae2; }

      .steps-wrap { overflow-x:auto; padding-bottom:8px; }
      .steps {
        display:grid;
        grid-template-columns: repeat(16, minmax(64px, 1fr));
        gap:8px;
        margin-top:12px;
        min-width:1180px;
      }
      .step {
        min-width:64px;
        text-align:center;
        padding:8px 3px 10px;
        border:1px solid transparent;
        border-radius:8px;
        transition:background .12s ease, border-color .12s ease, transform .12s ease;
      }
      .step.active {
        background:#f1efe6;
        border-color:#171717;
        transform:translateY(-2px);
      }
      .step.align-step { background:#faf4dc; }
      .step-number {
        font-size:11px;
        font-weight:800;
        margin-bottom:8px;
      }
      .knob-shell {
        width:58px;
        height:58px;
        margin:0 auto 8px;
        position:relative;
        cursor:ns-resize;
        touch-action:none;
        border-radius:50%;
        outline:none;
      }
      .knob-shell:focus-visible {
        box-shadow:0 0 0 3px rgba(23,23,23,.22);
      }
      .knob-shell.dragging {
        transform:scale(1.05);
      }
      .knob {
        width:46px;
        height:46px;
        position:absolute;
        left:6px;
        top:5px;
        border:2px solid #222;
        border-radius:50%;
        background:#ebe9e2;
        box-shadow:inset 0 0 0 2px #f7f6f1;
      }
      .knob::after {
        content:'';
        width:2px;
        height:16px;
        background:#222;
        position:absolute;
        left:20px;
        top:4px;
        transform-origin:1px 18px;
        transform:rotate(var(--angle));
      }
      .knob-dot {
        position:absolute;
        width:3px;
        height:3px;
        border-radius:50%;
        background:#777;
        left:27px;
        top:0;
        transform-origin:2px 29px;
        transform:rotate(var(--dot-angle)) translateY(-1px);
      }
      .timing-value {
        min-height:25px;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:11px;
        font-weight:800;
        border:1px solid #b8b4a9;
        border-radius:4px;
        background:#f7f6f1;
        user-select:none;
      }
      .step.align-step .timing-value {
        border-color:#8f7928;
        background:#fff8dc;
      }

      .explain-strip {
        display:flex;
        gap:14px;
        align-items:center;
        flex-wrap:wrap;
        margin-top:18px;
        padding:12px 14px;
        background:#f7f6f1;
        border-radius:8px;
        font-size:13px;
      }
      .legend-chip {
        display:inline-flex;
        align-items:center;
        gap:6px;
      }
      .legend-swatch {
        width:26px;
        height:12px;
        border:1px solid #777;
        background:#e6e3d9;
      }
      .legend-swatch.align {
        background:repeating-linear-gradient(
          135deg,
          #f3e8ba 0 6px,
          #fff8dc 6px 12px
        );
      }

      .timeline-shell {
        margin-top:28px;
        border:1px solid #cbc8bd;
        border-radius:10px;
        overflow:hidden;
        background:#fbfaf6;
      }
      .timeline-toolbar {
        display:flex;
        justify-content:space-between;
        gap:16px;
        align-items:center;
        padding:10px 14px;
        border-bottom:1px solid #d8d5ca;
        font-size:12px;
      }
      .timeline-scroll {
        overflow:hidden;
        position:relative;
        width:100%;
      }
      .timeline-stage {
        position:relative;
        min-height:164px;
        width:100%;
      }
      .ruler {
        position:absolute;
        left:0;
        top:0;
        height:38px;
        width:100%;
      }
      .bar-line {
        position:absolute;
        top:0;
        bottom:0;
        border-left:2px solid #292929;
        z-index:1;
      }
      .eighth-line {
        position:absolute;
        top:22px;
        height:13px;
        border-left:1px solid #d1cec3;
        z-index:0;
      }
      .bar-label {
        position:absolute;
        top:6px;
        font-size:11px;
        font-weight:800;
        transform:translateX(5px);
        white-space:nowrap;
      }
      .bar-length {
        font-weight:600;
        opacity:.62;
        margin-left:4px;
      }
      .sequence-track {
        position:absolute;
        left:0;
        top:40px;
        height:58px;
        width:100%;
      }
      .reference-track {
        position:absolute;
        left:0;
        top:103px;
        height:42px;
        width:100%;
        border-top:1px solid #c9c5b9;
        background:rgba(245,243,236,.55);
      }
      .reference-label {
        position:absolute;
        left:8px;
        top:4px;
        z-index:3;
        font-size:10px;
        font-weight:800;
        letter-spacing:.06em;
        text-transform:uppercase;
        background:#fbfaf6;
        padding:0 4px;
      }
      .beat-pulse {
        position:absolute;
        top:19px;
        width:2px;
        height:13px;
        background:#9f9b90;
        transform:translateX(-1px);
      }
      .beat-pulse.quarter {
        top:15px;
        height:20px;
        background:#5f5b51;
      }
      .beat-pulse.downbeat {
        top:11px;
        height:26px;
        width:3px;
        background:#222;
      }
      .bar-band {
        position:absolute;
        top:0;
        bottom:0;
        pointer-events:none;
        z-index:0;
      }
      .bar-band.alt {
        background:rgba(0,0,0,.028);
      }
      .segment {
        position:absolute;
        top:6px;
        height:44px;
        min-width:3px;
        border:1px solid #858175;
        background:#e7e4da;
        border-radius:4px;
        display:flex;
        align-items:center;
        justify-content:center;
        overflow:hidden;
        font-size:11px;
        font-weight:800;
        transition:filter .12s ease, transform .12s ease;
      }
      .segment.align {
        background:repeating-linear-gradient(
          135deg,
          #f3e8ba 0 8px,
          #fff8dc 8px 16px
        );
        border-color:#8f7928;
      }
      .segment.skip {
        width:3px !important;
        background:#b8b4a9;
        border:0;
        border-radius:0;
      }
      .segment.active {
        filter:brightness(.83);
        transform:translateY(-4px);
      }
      .playhead {
        position:absolute;
        top:0;
        bottom:0;
        width:3px;
        background:#c33422;
        left:0;
        z-index:10;
        pointer-events:none;
        transition:left .08s linear;
      }
      .status {
        padding:12px 14px;
        border-top:1px solid #d8d5ca;
        font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size:13px;
      }
      .microcopy {
        margin-top:10px;
        font-size:12px;
        color:#555;
      }

      /* Chord programming */
      .chord-workflow{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(420px,1.5fr);gap:22px;margin-top:22px}
      .chord-panel{border:1px solid #cbc8bd;border-radius:10px;background:#fbfaf6;padding:18px}
      .chord-panel h3{margin:0 0 14px;font-size:14px;letter-spacing:.02em}
      .hardware-state{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
      .state-pill{display:inline-flex;align-items:center;min-height:34px;padding:7px 10px;border:1px solid #aaa69a;background:#f3f1ea;font-size:12px;font-weight:800}
      .state-pill.active{background:#171717;color:#fff;border-color:#171717}
      .pitch-slot-control{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:18px;margin-top:16px}
      .pitch-program-knob-shell{width:86px;height:86px;position:relative;border-radius:50%;outline:none;cursor:ns-resize;touch-action:none}
      .pitch-program-knob-shell:focus-visible{box-shadow:0 0 0 3px rgba(23,23,23,.22)}
      .pitch-program-knob{width:60px;height:60px;position:absolute;left:13px;top:13px;border:2px solid #222;border-radius:50%;background:#ebe9e2;box-shadow:inset 0 0 0 2px #f7f6f1}
      .pitch-program-knob::after{content:'';position:absolute;width:2px;height:21px;left:27px;top:5px;background:#222;transform-origin:1px 25px;transform:rotate(var(--slot-angle))}
      .pitch-slot-dot{position:absolute;width:4px;height:4px;border-radius:50%;background:#777;left:41px;top:2px;transform-origin:2px 41px;transform:rotate(var(--slot-dot-angle))}
      .slot-readout{font-size:13px;line-height:1.45}.slot-readout strong{display:block;font-size:23px;line-height:1.1}
      .slot-bank{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-top:15px}
      .slot-button{min-width:0;padding:7px 4px;font-size:11px;font-weight:800}.slot-button.active{background:#171717;color:#fff;border-color:#171717}.slot-button.has-chord::after{content:' •'}
      .program-instruction{margin-top:14px;padding:10px 12px;border-left:3px solid #171717;background:#f1efe7;font-size:13px;line-height:1.45}.program-instruction.locked{border-left-color:#999;color:#666}
      .midi-note-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:5px;margin-top:14px}
      .midi-note{min-width:0;padding:18px 2px;font-size:11px;font-weight:800;position:relative}
      .midi-note.black-note{background:#292929;color:#fff}.midi-note.held{box-shadow:inset 0 0 0 3px #c33422}.midi-note.root-key::after{content:'1st';position:absolute;top:2px;right:2px;font-size:8px;background:#c33422;color:#fff;padding:2px 3px}
      .midi-note:disabled{opacity:.42;cursor:not-allowed}
      .held-notes{display:flex;gap:8px;align-items:center;flex-wrap:wrap;min-height:36px;margin-top:10px;font-size:12px}
      .note-chip{display:inline-flex;gap:5px;align-items:center;border:1px solid #aaa69a;background:#f3f1ea;padding:5px 7px;border-radius:4px;font-weight:800}.note-chip.root{border-color:#c33422}
      .store-row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}.store-row button:disabled{opacity:.45;cursor:not-allowed}
      .output-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
      .output-box{border:1px solid #cbc8bd;background:#fff;border-radius:8px;padding:12px;min-height:96px}
      .output-label{font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;color:#5d594f}
      .output-value{margin-top:9px;font-size:18px;font-weight:800;min-height:24px}
      .output-box small{display:block;margin-top:6px;color:#666;line-height:1.35}
      .root-explainer{margin-top:14px;font-size:12px;line-height:1.5;color:#555}
      @media (max-width:900px){.chord-workflow{grid-template-columns:1fr}.output-grid{grid-template-columns:1fr}}

      @media (max-width:800px) {
        main { padding:24px 12px 60px; }
        .card { padding:18px; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>SND SAM-16 Online Manual</h1>
      <p>Interactive documentation prototype.</p>

      <section class="card">
        <h2>Variable Timing + ALIGN</h2>
        <p class="note">
          In <strong>var.</strong> mode, <strong>Row 3</strong> sets the duration of each step.
          Turn a Row 3 knob fully clockwise to <strong>ALIGN</strong> and the SAM holds at that
          point until the end of the current measure. The global <strong>Align</strong> setting
          defines the length of that measure.
        </p>

        <div class="controls">
          <div>
            <label for="align">GLOBAL ALIGN — measure length</label>
            <div class="control-group">
              <select id="align">
                {Array.from({length:16}, (_,i) => <option value={i+1} selected={i===7}>{i+1}/8</option>)}
              </select>
            </div>
          </div>
          <div>
            <label>TRANSPORT</label>
            <div class="control-group">
              <button id="play">Play</button>
              <button id="reset">Reset</button>
            </div>
          </div>
        </div>

        <div class="hardware-caption">ROW 3 — step length in VAR mode</div>

        <div class="steps-wrap">
          <div class="steps" id="steps">
            {Array.from({length:16}, (_,i) => (
              <div class="step" data-step={i}>
                <div class="step-number">STEP {i+1}</div>
                <div
                  class="knob-shell"
                  role="slider"
                  tabindex="0"
                  aria-label={`Row 3 timing for step ${i+1}`}
                  aria-valuemin="0"
                  aria-valuemax="6"
                  aria-valuenow={i===7 ? "6" : "3"}
                  aria-valuetext={i===7 ? "ALIGN" : "1/8"}
                  data-index={i===7 ? "6" : "3"}
                >
                  {[-150,-120,-60,0,60,120,150].map(a => <i class="knob-dot" style={`--dot-angle:${a}deg`}></i>)}
                  <div class="knob" style="--angle:0deg"></div>
                </div>
                <div class="timing-value" aria-hidden="true">{i===7 ? "ALIGN" : "1/8"}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="explain-strip">
          <span><strong>Timeline:</strong></span>
          <span class="legend-chip"><span class="legend-swatch"></span> each numbered block = one SAM step</span>
          <span class="legend-chip"><span class="legend-swatch align"></span> ALIGN = wait to the next measure boundary</span>
        </div>

        <div class="timeline-shell">
          <div class="timeline-toolbar">
            <strong>WHAT THE SAM IS DOING OVER TIME</strong>
            <span id="measureInfo">Align = 8/8</span>
          </div>
          <div class="timeline-scroll" id="timelineScroll">
            <div class="timeline-stage" id="timelineStage" aria-label="SAM step timing over a fixed 16/8 window with straight reference grid">
              <div class="ruler" id="ruler"></div>
              <div class="sequence-track" id="sequenceTrack"></div>
              <div class="reference-track" id="referenceTrack">
                <span class="reference-label">STRAIGHT 16TH GRID</span>
              </div>
              <div class="playhead" id="playhead"></div>
            </div>
          </div>
          <div class="status" id="status">Stopped — Step 1</div>
        </div>

        <p class="microcopy">
          Drag a Row 3 knob up or down to move through its detents. The upper lane shows the SAM timing; the straight 16th grid underneath stays fixed. The display always covers 16/8. Changing Global Align moves only the measure boundaries unless a step is actually set to ALIGN.
        </p>
      </section>


      <section class="card" id="chordProgramming">
        <h2>Chord Programming + Root Note</h2>
        <p class="note">
          In <strong>PROGRAM</strong>, the <strong>Step 1 Pitch selector</strong> chooses one of 12 programmable note/chord positions.
          Play up to seven MIDI notes; releasing the keys stores them. The <strong>first note entered</strong> becomes the monophonic Pitch-CV note and,
          in Dual/X-fade modes, the note sent on the adjacent MIDI channel.
        </p>

        <div class="chord-workflow">
          <div class="chord-panel">
            <h3>1 — Hardware state + memory position</h3>
            <div class="hardware-state">
              <button id="chordStop" class="state-pill active">STOPPED</button>
              <button id="chordRun" class="state-pill">RUN</button>
              <button id="chordProgram" class="state-pill">SCALE → PROGRAM</button>
            </div>

            <div class="hardware-caption">STEP 1 — PITCH SELECTOR</div>
            <div class="pitch-slot-control">
              <div class="pitch-program-knob-shell" id="pitchProgramKnob" role="slider" tabindex="0" aria-label="Step 1 Pitch selector" aria-valuemin="1" aria-valuemax="12" aria-valuenow="1">
                <i class="pitch-slot-dot" style="--slot-dot-angle:-150deg"></i><i class="pitch-slot-dot" style="--slot-dot-angle:-123deg"></i>
                <i class="pitch-slot-dot" style="--slot-dot-angle:-95deg"></i><i class="pitch-slot-dot" style="--slot-dot-angle:-68deg"></i>
                <i class="pitch-slot-dot" style="--slot-dot-angle:-41deg"></i><i class="pitch-slot-dot" style="--slot-dot-angle:-14deg"></i>
                <i class="pitch-slot-dot" style="--slot-dot-angle:14deg"></i><i class="pitch-slot-dot" style="--slot-dot-angle:41deg"></i>
                <i class="pitch-slot-dot" style="--slot-dot-angle:68deg"></i><i class="pitch-slot-dot" style="--slot-dot-angle:95deg"></i>
                <i class="pitch-slot-dot" style="--slot-dot-angle:123deg"></i><i class="pitch-slot-dot" style="--slot-dot-angle:150deg"></i>
                <div class="pitch-program-knob" style="--slot-angle:-150deg"></div>
              </div>
              <div class="slot-readout">
                <span>Selected programmable position</span>
                <strong id="pitchSlotReadout">1 / 12</strong>
                <span id="pitchSlotStored">empty</span>
              </div>
            </div>

            <div class="slot-bank" id="pitchSlotBank">
              <button class="slot-button active" data-slot="0">POS 1</button><button class="slot-button" data-slot="1">POS 2</button>
              <button class="slot-button" data-slot="2">POS 3</button><button class="slot-button" data-slot="3">POS 4</button>
              <button class="slot-button" data-slot="4">POS 5</button><button class="slot-button" data-slot="5">POS 6</button>
              <button class="slot-button" data-slot="6">POS 7</button><button class="slot-button" data-slot="7">POS 8</button>
              <button class="slot-button" data-slot="8">POS 9</button><button class="slot-button" data-slot="9">POS 10</button>
              <button class="slot-button" data-slot="10">POS 11</button><button class="slot-button" data-slot="11">POS 12</button>
            </div>

            <div class="program-instruction locked" id="programInstruction">
              STOP the SAM, then move the Scale switch to PROGRAM. Only then can the selected Pitch position be written.
            </div>
          </div>

          <div class="chord-panel">
            <h3>2 — Play the chord from MIDI In</h3>
            <p class="microcopy" style="margin-top:0">
              This one-octave keyboard is a teaching view. Select notes in the order you would hold them on a MIDI keyboard. The first selected note is marked <strong>1st</strong>.
            </p>

            <div class="midi-note-grid" id="midiKeyboard">
              <button class="midi-note" data-note="C" disabled>C</button>
              <button class="midi-note black-note" data-note="C♯" disabled>C♯</button>
              <button class="midi-note" data-note="D" disabled>D</button>
              <button class="midi-note black-note" data-note="D♯" disabled>D♯</button>
              <button class="midi-note" data-note="E" disabled>E</button>
              <button class="midi-note" data-note="F" disabled>F</button>
              <button class="midi-note black-note" data-note="F♯" disabled>F♯</button>
              <button class="midi-note" data-note="G" disabled>G</button>
              <button class="midi-note black-note" data-note="G♯" disabled>G♯</button>
              <button class="midi-note" data-note="A" disabled>A</button>
              <button class="midi-note black-note" data-note="A♯" disabled>A♯</button>
              <button class="midi-note" data-note="B" disabled>B</button>
            </div>

            <div class="held-notes" id="heldNotes"><span>No MIDI notes held.</span></div>
            <div class="store-row">
              <button id="storeChord" disabled>Release keys → Store</button>
              <button id="clearHeld" disabled>Clear held notes</button>
            </div>

            <div class="output-grid">
              <div class="output-box"><div class="output-label">MIDI base channel</div><div class="output-value" id="baseChordOutput">—</div><small>Full programmed note/chord.</small></div>
              <div class="output-box"><div class="output-label">Pitch CV</div><div class="output-value" id="pitchCvOutput">—</div><small>Monophonic: first-entered note.</small></div>
              <div class="output-box"><div class="output-label">Adjacent MIDI channel</div><div class="output-value" id="adjacentOutput">—</div><small>First-entered note in Dual / X-fade modes.</small></div>
            </div>

            <div class="root-explainer" id="rootExplainer">
              Positions 1 and 2 start with the same C–E–G chord but different first-entered notes. Switch between them to see the SAM's root-note behavior.
            </div>
          </div>
        </div>
      </section>


      <script is:inline>
        const eighthMs = 240;
        let pxPerEighth = 48;

        const viewEighths = 16;

        function horizonEighths() {
          return viewEighths;
        }
        const angleMap = {
          '0':'-150deg',
          '0.25':'-120deg',
          '0.5':'-60deg',
          '1':'0deg',
          '2':'60deg',
          '4':'120deg',
          '-1':'150deg'
        };

        const steps = [...document.querySelectorAll('.step')];
        const align = document.querySelector('#align');
        const ruler = document.querySelector('#ruler');
        const sequenceTrack = document.querySelector('#sequenceTrack');
        const stage = document.querySelector('#timelineStage');
        const playhead = document.querySelector('#playhead');
        const status = document.querySelector('#status');
        const measureInfo = document.querySelector('#measureInfo');
        const timelineScroll = document.querySelector('#timelineScroll');
        const referenceTrack = document.querySelector('#referenceTrack');

        let running = false;
        let timer = null;
        let stepIndex = 0;
        let pos = 0;
        let activeSegment = null;

        const timingOptions = [
          { label:'SKIP', value:0 },
          { label:'1/32', value:0.25 },
          { label:'1/16', value:0.5 },
          { label:'1/8', value:1 },
          { label:'1/4', value:2 },
          { label:'1/2', value:4 },
          { label:'ALIGN', value:-1 }
        ];

        function knobEl(stepEl) {
          return stepEl.querySelector('.knob-shell');
        }

        function currentIndex(stepEl) {
          return Number(knobEl(stepEl).dataset.index);
        }

        function currentValue(stepEl) {
          return timingOptions[currentIndex(stepEl)].value;
        }

        function setTimingIndex(stepEl, nextIndex, redrawTimeline = true) {
          const index = Math.max(0, Math.min(timingOptions.length - 1, nextIndex));
          const shell = knobEl(stepEl);
          const option = timingOptions[index];
          shell.dataset.index = String(index);
          shell.setAttribute('aria-valuenow', String(index));
          shell.setAttribute('aria-valuetext', option.label);
          stepEl.querySelector('.timing-value').textContent = option.label;
          refreshKnob(stepEl);
          if (redrawTimeline) renderSequence();
        }

        function nextBoundary(position, measureLength) {
          const remainder = position % measureLength;
          if (Math.abs(remainder) < 0.000001) return position + measureLength;
          return position + (measureLength - remainder);
        }

        function refreshKnob(step) {
          const value = String(currentValue(step));
          step.querySelector('.knob').style.setProperty('--angle', angleMap[value] || '0deg');
          step.classList.toggle('align-step', value === '-1');
        }

        function refreshKnobs() {
          steps.forEach(refreshKnob);
        }

        function renderRuler() {
          ruler.innerHTML = '';
          [...stage.querySelectorAll('.bar-band')].forEach(el => el.remove());

          const measure = Number(align.value);
          const horizon = horizonEighths();
          const available = Math.max(1, timelineScroll.clientWidth || stage.parentElement.clientWidth || 1);
          pxPerEighth = available / horizon;
          stage.style.width = '100%';
          measureInfo.textContent = `Fixed view: 16/8 · Align boundaries every ${measure}/8`;

          const measureCount = Math.ceil(horizon / measure);

          for (let bar = 0; bar < measureCount; bar++) {
            const start = bar * measure;
            const width = Math.min(measure, horizon - start);
            if (width <= 0) break;

            const band = document.createElement('div');
            band.className = 'bar-band' + (bar % 2 ? ' alt' : '');
            band.style.left = (start * pxPerEighth) + 'px';
            band.style.width = (width * pxPerEighth) + 'px';
            stage.insertBefore(band, ruler);
          }

          for (let i = 0; i <= horizon; i++) {
            const isMeasureBoundary = i % measure === 0;
            const line = document.createElement('div');
            line.className = isMeasureBoundary ? 'bar-line' : 'eighth-line';
            line.style.left = (i * pxPerEighth) + 'px';
            ruler.appendChild(line);

            if (isMeasureBoundary && i < horizon) {
              const measureNumber = Math.floor(i / measure) + 1;
              const label = document.createElement('div');
              label.className = 'bar-label';
              label.style.left = (i * pxPerEighth) + 'px';

              if (measure <= 2) {
                label.textContent = `M${measureNumber}`;
              } else if (measure <= 4) {
                label.innerHTML = `M${measureNumber}<span class="bar-length">· ${measure}/8</span>`;
              } else {
                label.innerHTML = `MEASURE ${measureNumber}<span class="bar-length">· ${measure}/8</span>`;
              }
              ruler.appendChild(label);
            }
          }
        }

        function computeSegments() {
          const measure = Number(align.value);
          const result = [];
          let p = 0;
          let index = 0;
          let safety = 0;

          const horizon = horizonEighths();
          while (p < horizon && safety < 256) {
            const stepEl = steps[index];
            const value = currentValue(stepEl);
            let duration = value;
            let type = 'normal';

            if (value === -1) {
              duration = nextBoundary(p, measure) - p;
              type = 'align';
            } else if (value === 0) {
              duration = 0;
              type = 'skip';
            }

            result.push({
              step: index + 1,
              start: p,
              duration,
              type
            });

            if (duration > 0) p += duration;
            index = (index + 1) % 16;
            safety++;
          }
          return result;
        }

        function renderReference() {
          [...referenceTrack.querySelectorAll('.beat-pulse')].forEach(el => el.remove());
          const horizon = horizonEighths();
          const measure = Number(align.value);
          const sixteenthCount = Math.round(horizon * 2);

          for (let i = 0; i <= sixteenthCount; i++) {
            const p = i / 2;
            const pulse = document.createElement('i');
            const isDownbeat = Math.abs(p % measure) < 0.000001;
            const isQuarter = i % 2 === 0;
            pulse.className = 'beat-pulse' + (isQuarter ? ' quarter' : '') + (isDownbeat ? ' downbeat' : '');
            pulse.style.left = (p * pxPerEighth) + 'px';
            referenceTrack.appendChild(pulse);
          }
        }

        function renderSequence() {
          sequenceTrack.innerHTML = '';
          const segments = computeSegments();

          segments.forEach((seg, i) => {
            const block = document.createElement('div');
            block.className = 'segment ' + seg.type;
            block.dataset.segment = String(i);
            block.dataset.step = String(seg.step - 1);
            block.style.left = (seg.start * pxPerEighth) + 'px';

            if (seg.type === 'skip') {
              block.style.width = '3px';
              block.title = `Step ${seg.step}: SKIP`;
            } else {
              block.style.width = Math.max(4, seg.duration * pxPerEighth - 2) + 'px';
              block.textContent = seg.type === 'align' ? `${seg.step} · ALIGN` : String(seg.step);
              block.title = seg.type === 'align'
                ? `Step ${seg.step}: ALIGN hold ${seg.duration}/8 until measure boundary`
                : `Step ${seg.step}: ${seg.duration}/8`;
            }
            sequenceTrack.appendChild(block);
          });
        }

        function redraw() {
          refreshKnobs();
          renderRuler();
          renderSequence();
          renderReference();
        }

        function clearActive() {
          steps.forEach(s => s.classList.remove('active'));
          if (activeSegment) activeSegment.classList.remove('active');
          activeSegment = null;
        }

        function findSegmentAt(step, startPos) {
          const segments = [...sequenceTrack.querySelectorAll('.segment')];
          return segments.find(el => {
            const left = parseFloat(el.style.left) / pxPerEighth;
            return Number(el.dataset.step) === step && Math.abs(left - startPos) < 0.001;
          }) || null;
        }

        function advance() {
          if (!running) return;

          clearActive();
          const stepEl = steps[stepIndex];
          stepEl.classList.add('active');

          const value = currentValue(stepEl);
          const measure = Number(align.value);
          const startPos = pos;
          let duration = value;
          let description = '';

          if (value === -1) {
            duration = nextBoundary(pos, measure) - pos;
            description = `Step ${stepIndex + 1}: ALIGN — wait ${duration}/8 until the next measure boundary`;
          } else if (value === 0) {
            duration = 0;
            description = `Step ${stepIndex + 1}: SKIP`;
          } else {
            description = `Step ${stepIndex + 1}: ${timingOptions[currentIndex(stepEl)].label}`;
          }

          const horizon = horizonEighths();
          activeSegment = findSegmentAt(stepIndex, startPos % horizon);
          if (activeSegment) activeSegment.classList.add('active');

          status.textContent = description;

          if (duration > 0) {
            const nextPos = pos + duration;
            const reachesWindowEnd = nextPos >= horizon - 0.000001;

            if (reachesWindowEnd) {
              pos = horizon;
              playhead.style.left = (horizon * pxPerEighth) + 'px';

              const nextHardwareStep = (stepIndex + 1) % 16;
              const delay = Math.max(90, duration * eighthMs);
              timer = setTimeout(() => {
                running = false;
                clearActive();
                document.querySelector('#play').textContent = 'Play';
                status.textContent = `End of fixed 16/8 view — SAM continues with Step ${nextHardwareStep + 1}`;
              }, delay);
              return;
            }

            pos = nextPos;
            playhead.style.left = (pos * pxPerEighth) + 'px';
          }

          stepIndex = (stepIndex + 1) % 16;
          timer = setTimeout(advance, Math.max(90, duration > 0 ? duration * eighthMs : 90));
        }

        document.querySelector('#play').onclick = () => {
          running = !running;
          document.querySelector('#play').textContent = running ? 'Pause' : 'Play';
          if (running) advance();
          else clearTimeout(timer);
        };

        function resetTransport(message = 'Stopped — Step 1') {
          running = false;
          clearTimeout(timer);
          clearActive();
          stepIndex = 0;
          pos = 0;
          playhead.style.left = '0px';
          timelineScroll.scrollLeft = 0;
          status.textContent = message;
          document.querySelector('#play').textContent = 'Play';
        }

        document.querySelector('#reset').onclick = () => {
          resetTransport();
        };

        function applyAlignChange() {
          const measure = Number(align.value);
          resetTransport(`Align = ${measure}/8 — fixed 16/8 view. Row 3 step lengths are unchanged; only Align boundaries move unless a step uses ALIGN.`);
          redraw();
        }

        align.addEventListener('input', applyAlignChange);
        align.addEventListener('change', applyAlignChange);

        steps.forEach(step => {
          const shell = knobEl(step);
          let startY = 0;
          let startIndex = 0;
          let movedIndex = 0;

          shell.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            resetTransport();
            shell.setPointerCapture(event.pointerId);
            shell.classList.add('dragging');
            startY = event.clientY;
            startIndex = currentIndex(step);
            movedIndex = startIndex;
            shell.focus();
          });

          shell.addEventListener('pointermove', (event) => {
            if (!shell.hasPointerCapture(event.pointerId)) return;
            const delta = startY - event.clientY;
            const detents = Math.round(delta / 18);
            const nextIndex = Math.max(0, Math.min(6, startIndex + detents));
            if (nextIndex !== movedIndex) {
              movedIndex = nextIndex;
              setTimingIndex(step, nextIndex);
            }
          });

          const endDrag = (event) => {
            if (shell.hasPointerCapture(event.pointerId)) shell.releasePointerCapture(event.pointerId);
            shell.classList.remove('dragging');
          };
          shell.addEventListener('pointerup', endDrag);
          shell.addEventListener('pointercancel', endDrag);

          shell.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowUp' || event.key === 'ArrowRight') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, currentIndex(step) + 1);
            } else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, currentIndex(step) - 1);
            } else if (event.key === 'Home') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, 0);
            } else if (event.key === 'End') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, 6);
            }
          });

          shell.addEventListener('wheel', (event) => {
            event.preventDefault();
            resetTransport();
            setTimingIndex(step, currentIndex(step) + (event.deltaY < 0 ? 1 : -1));
          }, { passive:false });
        });


        // Chord programming simulator
        const chordStop = document.querySelector('#chordStop');
        const chordRun = document.querySelector('#chordRun');
        const chordProgram = document.querySelector('#chordProgram');
        const programInstruction = document.querySelector('#programInstruction');
        const pitchProgramKnob = document.querySelector('#pitchProgramKnob');
        const pitchSlotReadout = document.querySelector('#pitchSlotReadout');
        const pitchSlotStored = document.querySelector('#pitchSlotStored');
        const pitchSlotButtons = [...document.querySelectorAll('.slot-button')];
        const midiKeys = [...document.querySelectorAll('.midi-note')];
        const heldNotesEl = document.querySelector('#heldNotes');
        const storeChordBtn = document.querySelector('#storeChord');
        const clearHeldBtn = document.querySelector('#clearHeld');
        const baseChordOutput = document.querySelector('#baseChordOutput');
        const pitchCvOutput = document.querySelector('#pitchCvOutput');
        const adjacentOutput = document.querySelector('#adjacentOutput');
        const rootExplainer = document.querySelector('#rootExplainer');

        const pitchClassOrder = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
        const chordSlots = Array.from({length:12}, () => ({notes:[], root:null}));
        chordSlots[0] = {notes:['C','E','G'], root:'C'};
        chordSlots[1] = {notes:['C','E','G'], root:'E'};

        let chordTransportStopped = true;
        let chordProgramMode = false;
        let selectedPitchSlot = 0;
        let heldOrder = [];

        function chordSort(notes) {
          return [...notes].sort((a,b) => pitchClassOrder.indexOf(a) - pitchClassOrder.indexOf(b));
        }

        function chordText(notes) {
          return notes.length ? chordSort(notes).join(' · ') : '—';
        }

        function setChordTransport(stopped) {
          chordTransportStopped = stopped;
          chordStop.classList.toggle('active', stopped);
          chordRun.classList.toggle('active', !stopped);
          if (!stopped) chordProgramMode = false;
          refreshChordProgramState();
        }

        function refreshChordProgramState() {
          chordProgram.classList.toggle('active', chordProgramMode);
          chordProgram.textContent = chordProgramMode ? 'SCALE → PROGRAM ✓' : 'SCALE → PROGRAM';
          const writable = chordTransportStopped && chordProgramMode;

          midiKeys.forEach(key => key.disabled = !writable);
          if (!writable) heldOrder = [];

          if (!chordTransportStopped) {
            programInstruction.textContent = 'RUNNING — PROGRAM cannot be selected. Stop the SAM first.';
          } else if (!chordProgramMode) {
            programInstruction.textContent = 'STOPPED — now move the Scale switch to PROGRAM.';
          } else {
            programInstruction.textContent = 'PROGRAM active — Step 1 Pitch selects the memory position. Select up to seven MIDI notes, then release/store them.';
          }
          programInstruction.classList.toggle('locked', !writable);
          refreshHeldNotes();
        }

        function setPitchSlot(index) {
          selectedPitchSlot = Math.max(0, Math.min(11, index));
          const angle = -150 + selectedPitchSlot * (300 / 11);
          pitchProgramKnob.querySelector('.pitch-program-knob').style.setProperty('--slot-angle', angle + 'deg');
          pitchProgramKnob.setAttribute('aria-valuenow', String(selectedPitchSlot + 1));
          pitchSlotReadout.textContent = String(selectedPitchSlot + 1) + ' / 12';
          pitchSlotButtons.forEach((button,i) => button.classList.toggle('active', i === selectedPitchSlot));
          refreshStoredSlot();
        }

        function refreshStoredSlot() {
          const slot = chordSlots[selectedPitchSlot];
          pitchSlotStored.textContent = slot.notes.length ? chordText(slot.notes) + ' · root ' + slot.root : 'empty';

          pitchSlotButtons.forEach((button,i) => {
            button.classList.toggle('has-chord', chordSlots[i].notes.length > 0);
            button.title = chordSlots[i].notes.length
              ? 'Position ' + (i+1) + ': ' + chordText(chordSlots[i].notes) + ' · root ' + chordSlots[i].root
              : 'Position ' + (i+1) + ': empty';
          });

          baseChordOutput.textContent = chordText(slot.notes);
          pitchCvOutput.textContent = slot.root || '—';
          adjacentOutput.textContent = slot.root || '—';

          if (slot.notes.length) {
            rootExplainer.innerHTML = 'Stored position <strong>' + (selectedPitchSlot + 1) + '</strong>: full chord <strong>' + chordText(slot.notes) + '</strong>; first-entered/root note <strong>' + slot.root + '</strong>.';
          } else {
            rootExplainer.textContent = 'This position is empty. Enter PROGRAM, select notes, then use “Release keys → Store”.';
          }
        }

        function refreshHeldNotes() {
          midiKeys.forEach(key => {
            const note = key.dataset.note;
            key.classList.toggle('held', heldOrder.includes(note));
            key.classList.toggle('root-key', heldOrder[0] === note);
          });

          if (!heldOrder.length) {
            heldNotesEl.innerHTML = '<span>No MIDI notes held.</span>';
          } else {
            heldNotesEl.innerHTML = heldOrder.map((note,i) => '<span class="note-chip ' + (i===0 ? 'root' : '') + '">' + note + (i===0 ? ' · 1st/root' : '') + '</span>').join('');
          }

          const writable = chordTransportStopped && chordProgramMode;
          storeChordBtn.disabled = !writable || heldOrder.length === 0;
          clearHeldBtn.disabled = !writable || heldOrder.length === 0;
        }

        chordStop.addEventListener('click', () => setChordTransport(true));
        chordRun.addEventListener('click', () => setChordTransport(false));

        chordProgram.addEventListener('click', () => {
          if (!chordTransportStopped) {
            refreshChordProgramState();
            return;
          }
          chordProgramMode = !chordProgramMode;
          refreshChordProgramState();
        });

        pitchSlotButtons.forEach((button,i) => button.addEventListener('click', () => setPitchSlot(i)));

        pitchProgramKnob.addEventListener('wheel', event => {
          event.preventDefault();
          setPitchSlot(selectedPitchSlot + (event.deltaY < 0 ? 1 : -1));
        }, {passive:false});

        pitchProgramKnob.addEventListener('keydown', event => {
          if (event.key === 'ArrowUp' || event.key === 'ArrowRight') {
            event.preventDefault();
            setPitchSlot(selectedPitchSlot + 1);
          } else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
            event.preventDefault();
            setPitchSlot(selectedPitchSlot - 1);
          } else if (event.key === 'Home') {
            event.preventDefault();
            setPitchSlot(0);
          } else if (event.key === 'End') {
            event.preventDefault();
            setPitchSlot(11);
          }
        });

        midiKeys.forEach(key => {
          key.addEventListener('click', () => {
            if (!chordTransportStopped || !chordProgramMode) return;
            const note = key.dataset.note;
            const existing = heldOrder.indexOf(note);
            if (existing >= 0) {
              heldOrder.splice(existing, 1);
            } else if (heldOrder.length < 7) {
              heldOrder.push(note);
            }
            refreshHeldNotes();
          });
        });

        clearHeldBtn.addEventListener('click', () => {
          heldOrder = [];
          refreshHeldNotes();
        });

        storeChordBtn.addEventListener('click', () => {
          if (!heldOrder.length || !chordTransportStopped || !chordProgramMode) return;

          const root = heldOrder[0];
          const notes = chordSort(heldOrder);
          chordSlots[selectedPitchSlot] = {notes:notes, root:root};

          const storedChord = chordText(notes);
          heldOrder = [];
          refreshHeldNotes();
          refreshStoredSlot();
          rootExplainer.innerHTML = 'Released/stored: <strong>' + storedChord + '</strong>. Because <strong>' + root + '</strong> was entered first, the monophonic/root output is <strong>' + root + '</strong>.';
        });

        setPitchSlot(0);
        refreshChordProgramState();


        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(redraw, 120);
        });

        redraw();
      </script>
    </main>
  </body>
</html>
