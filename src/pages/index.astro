---
const timingValues = [
  { label: 'SKIP', eighths: 0 },
  { label: '1/32', eighths: 0.25 },
  { label: '1/16', eighths: 0.5 },
  { label: '1/8', eighths: 1 },
  { label: '1/4', eighths: 2 },
  { label: '1/2', eighths: 4 },
  { label: 'ALIGN', eighths: -1 }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>SND SAM-16 Online Manual</title>
    <style is:global>
      :root {
        font-family: Inter, system-ui, sans-serif;
        color: #171717;
        background: #f2f1ec;
      }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { max-width: 1380px; margin: 0 auto; padding: 36px 24px 80px; }
      h1,h2 { letter-spacing: -.025em; }
      .card {
        background: #fff;
        border: 1px solid #d7d4cb;
        border-radius: 14px;
        padding: 28px;
        margin-top: 24px;
      }
      .note { max-width: 900px; line-height: 1.55; }
      .hardware-caption {
        margin-top: 24px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .controls {
        display:flex;
        gap:28px;
        flex-wrap:wrap;
        align-items:end;
        margin-top: 20px;
      }
      .control-group { display:flex; gap:12px; align-items:end; }
      label {
        font-size: 12px;
        font-weight: 800;
        display:block;
        margin-bottom:6px;
        letter-spacing:.03em;
      }
      select, button {
        font: inherit;
        padding: 8px 10px;
        background: #f7f6f1;
        border: 1px solid #999;
      }
      button { cursor:pointer; min-width:76px; }
      button:hover { background:#eceae2; }

      .steps-wrap { overflow-x:auto; padding-bottom:8px; }
      .steps {
        display:grid;
        grid-template-columns: repeat(16, minmax(64px, 1fr));
        gap:8px;
        margin-top:12px;
        min-width:1180px;
      }
      .step {
        min-width:64px;
        text-align:center;
        padding:8px 3px 10px;
        border:1px solid transparent;
        border-radius:8px;
        transition:background .12s ease, border-color .12s ease, transform .12s ease;
      }
      .step.active {
        background:#f1efe6;
        border-color:#171717;
        transform:translateY(-2px);
      }
      .step.align-step { background:#faf4dc; }
      .step-number {
        font-size:11px;
        font-weight:800;
        margin-bottom:8px;
      }
      .knob-shell {
        width:58px;
        height:58px;
        margin:0 auto 8px;
        position:relative;
        cursor:ns-resize;
        touch-action:none;
        border-radius:50%;
        outline:none;
      }
      .knob-shell:focus-visible {
        box-shadow:0 0 0 3px rgba(23,23,23,.22);
      }
      .knob-shell.dragging {
        transform:scale(1.05);
      }
      .knob {
        width:46px;
        height:46px;
        position:absolute;
        left:6px;
        top:5px;
        border:2px solid #222;
        border-radius:50%;
        background:#ebe9e2;
        box-shadow:inset 0 0 0 2px #f7f6f1;
      }
      .knob::after {
        content:'';
        width:2px;
        height:16px;
        background:#222;
        position:absolute;
        left:20px;
        top:4px;
        transform-origin:1px 18px;
        transform:rotate(var(--angle));
      }
      .knob-dot {
        position:absolute;
        width:3px;
        height:3px;
        border-radius:50%;
        background:#777;
        left:27px;
        top:0;
        transform-origin:2px 29px;
        transform:rotate(var(--dot-angle)) translateY(-1px);
      }
      .timing-value {
        min-height:25px;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:11px;
        font-weight:800;
        border:1px solid #b8b4a9;
        border-radius:4px;
        background:#f7f6f1;
        user-select:none;
      }
      .step.align-step .timing-value {
        border-color:#8f7928;
        background:#fff8dc;
      }

      .explain-strip {
        display:flex;
        gap:14px;
        align-items:center;
        flex-wrap:wrap;
        margin-top:18px;
        padding:12px 14px;
        background:#f7f6f1;
        border-radius:8px;
        font-size:13px;
      }
      .legend-chip {
        display:inline-flex;
        align-items:center;
        gap:6px;
      }
      .legend-swatch {
        width:26px;
        height:12px;
        border:1px solid #777;
        background:#e6e3d9;
      }
      .legend-swatch.align {
        background:repeating-linear-gradient(
          135deg,
          #f3e8ba 0 6px,
          #fff8dc 6px 12px
        );
      }

      .timeline-shell {
        margin-top:28px;
        border:1px solid #cbc8bd;
        border-radius:10px;
        overflow:hidden;
        background:#fbfaf6;
      }
      .timeline-toolbar {
        display:flex;
        justify-content:space-between;
        gap:16px;
        align-items:center;
        padding:10px 14px;
        border-bottom:1px solid #d8d5ca;
        font-size:12px;
      }
      .timeline-scroll {
        overflow:hidden;
        position:relative;
        width:100%;
      }
      .timeline-stage {
        position:relative;
        min-height:164px;
        width:100%;
      }
      .ruler {
        position:absolute;
        left:0;
        top:0;
        height:38px;
        width:100%;
      }
      .bar-line {
        position:absolute;
        top:0;
        bottom:0;
        border-left:2px solid #292929;
        z-index:1;
      }
      .eighth-line {
        position:absolute;
        top:22px;
        height:13px;
        border-left:1px solid #d1cec3;
        z-index:0;
      }
      .bar-label {
        position:absolute;
        top:6px;
        font-size:11px;
        font-weight:800;
        transform:translateX(5px);
        white-space:nowrap;
      }
      .bar-length {
        font-weight:600;
        opacity:.62;
        margin-left:4px;
      }
      .sequence-track {
        position:absolute;
        left:0;
        top:40px;
        height:58px;
        width:100%;
      }
      .reference-track {
        position:absolute;
        left:0;
        top:103px;
        height:42px;
        width:100%;
        border-top:1px solid #c9c5b9;
        background:rgba(245,243,236,.55);
      }
      .reference-label {
        position:absolute;
        left:8px;
        top:4px;
        z-index:3;
        font-size:10px;
        font-weight:800;
        letter-spacing:.06em;
        text-transform:uppercase;
        background:#fbfaf6;
        padding:0 4px;
      }
      .beat-pulse {
        position:absolute;
        top:19px;
        width:2px;
        height:13px;
        background:#9f9b90;
        transform:translateX(-1px);
      }
      .beat-pulse.quarter {
        top:15px;
        height:20px;
        background:#5f5b51;
      }
      .beat-pulse.downbeat {
        top:11px;
        height:26px;
        width:3px;
        background:#222;
      }
      .bar-band {
        position:absolute;
        top:0;
        bottom:0;
        pointer-events:none;
        z-index:0;
      }
      .bar-band.alt {
        background:rgba(0,0,0,.028);
      }
      .segment {
        position:absolute;
        top:6px;
        height:44px;
        min-width:3px;
        border:1px solid #858175;
        background:#e7e4da;
        border-radius:4px;
        display:flex;
        align-items:center;
        justify-content:center;
        overflow:hidden;
        font-size:11px;
        font-weight:800;
        transition:filter .12s ease, transform .12s ease;
      }
      .segment.align {
        background:repeating-linear-gradient(
          135deg,
          #f3e8ba 0 8px,
          #fff8dc 8px 16px
        );
        border-color:#8f7928;
      }
      .segment.skip {
        width:3px !important;
        background:#b8b4a9;
        border:0;
        border-radius:0;
      }
      .segment.active {
        filter:brightness(.83);
        transform:translateY(-4px);
      }
      .playhead {
        position:absolute;
        top:0;
        bottom:0;
        width:3px;
        background:#c33422;
        left:0;
        z-index:10;
        pointer-events:none;
        transition:left .08s linear;
      }
      .status {
        padding:12px 14px;
        border-top:1px solid #d8d5ca;
        font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size:13px;
      }
      .microcopy {
        margin-top:10px;
        font-size:12px;
        color:#555;
      }

      /* Reusable SAM hardware recipe language */
      .hw-recipe {
        margin-top:22px;
        border:1px solid #cbc8bd;
        border-radius:10px;
        overflow:hidden;
        background:#fbfaf6;
      }
      .hw-recipe-head {
        padding:11px 14px;
        border-bottom:1px solid #d8d5ca;
        display:flex;
        justify-content:space-between;
        gap:16px;
        align-items:center;
        flex-wrap:wrap;
        font-size:12px;
      }
      .hw-flow {
        display:grid;
        grid-template-columns:repeat(5,minmax(0,1fr));
        align-items:stretch;
      }
      .hw-stage {
        min-width:0;
        padding:18px 14px 16px;
        border-right:1px solid #d8d5ca;
        position:relative;
        text-align:center;
      }
      .hw-stage:last-child { border-right:0; }
      .hw-stage::after {
        content:'→';
        position:absolute;
        right:-10px;
        top:50%;
        transform:translateY(-50%);
        width:20px;
        height:20px;
        display:grid;
        place-items:center;
        background:#fbfaf6;
        font-size:17px;
        font-weight:800;
        z-index:4;
      }
      .hw-stage:last-child::after { display:none; }
      .hw-kicker {
        font-size:10px;
        line-height:1.2;
        min-height:24px;
        font-weight:900;
        letter-spacing:.07em;
        text-transform:uppercase;
        color:#5b574e;
      }
      .hw-action {
        margin-top:10px;
        min-height:38px;
        font-size:13px;
        line-height:1.4;
        font-weight:800;
      }
      .hw-detail {
        margin-top:8px;
        font-size:11px;
        line-height:1.4;
        color:#666158;
      }
      .hw-step-badge {
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-width:72px;
        padding:6px 9px;
        margin:4px auto 8px;
        border:2px solid #171717;
        background:#171717;
        color:#fff;
        font-size:11px;
        font-weight:900;
        letter-spacing:.06em;
      }
      .hw-toggle {
        width:72px;
        height:94px;
        position:relative;
        margin:2px auto 4px;
      }
      .hw-toggle-track {
        position:absolute;
        left:34px;
        top:9px;
        width:4px;
        height:75px;
        border-radius:3px;
        background:#d3d0c7;
      }
      .hw-toggle-pos {
        position:absolute;
        left:29px;
        width:14px;
        height:14px;
        border:2px solid #858175;
        border-radius:50%;
        background:#fbfaf6;
      }
      .hw-toggle-pos.up { top:5px; }
      .hw-toggle-pos.mid { top:39px; }
      .hw-toggle-pos.down { top:73px; }
      .hw-toggle-pos.active {
        background:#171717;
        border-color:#171717;
      }
      .hw-toggle-lever {
        position:absolute;
        left:34px;
        top:14px;
        width:4px;
        height:45px;
        background:#171717;
        transform-origin:2px 37px;
        transform:rotate(22deg);
        border-radius:2px;
      }
      .hw-switch-labels {
        position:absolute;
        inset:0;
        pointer-events:none;
        font-size:9px;
        font-weight:900;
        text-align:left;
      }
      .hw-switch-labels span {
        position:absolute;
        left:47px;
        white-space:nowrap;
      }
      .hw-switch-labels .up { top:5px; }
      .hw-switch-labels .mid { top:39px; color:#999; }
      .hw-switch-labels .down { top:73px; color:#999; }
      .hw-mini-knob-shell {
        width:82px;
        height:82px;
        margin:2px auto 5px;
        position:relative;
      }
      .hw-mini-knob {
        position:absolute;
        width:56px;
        height:56px;
        left:13px;
        top:13px;
        border:2px solid #222;
        border-radius:50%;
        background:#ebe9e2;
        box-shadow:inset 0 0 0 2px #f7f6f1;
      }
      .hw-mini-knob::after {
        content:'';
        position:absolute;
        width:2px;
        height:19px;
        left:25px;
        top:5px;
        background:#222;
        transform-origin:1px 23px;
        transform:rotate(-68deg);
      }
      .hw-mini-dot {
        position:absolute;
        width:4px;
        height:4px;
        border-radius:50%;
        background:#777;
        left:39px;
        top:1px;
        transform-origin:2px 40px;
      }
      .hw-mini-dot:nth-child(1){transform:rotate(-150deg)}
      .hw-mini-dot:nth-child(2){transform:rotate(-123deg)}
      .hw-mini-dot:nth-child(3){transform:rotate(-95deg)}
      .hw-mini-dot:nth-child(4){transform:rotate(-68deg);background:#171717;width:6px;height:6px}
      .hw-mini-dot:nth-child(5){transform:rotate(-41deg)}
      .hw-mini-dot:nth-child(6){transform:rotate(-14deg)}
      .hw-mini-dot:nth-child(7){transform:rotate(14deg)}
      .hw-mini-dot:nth-child(8){transform:rotate(41deg)}
      .hw-mini-dot:nth-child(9){transform:rotate(68deg)}
      .hw-mini-dot:nth-child(10){transform:rotate(95deg)}
      .hw-mini-dot:nth-child(11){transform:rotate(123deg)}
      .hw-mini-dot:nth-child(12){transform:rotate(150deg)}
      .hw-midi-notes {
        display:flex;
        justify-content:center;
        align-items:center;
        gap:5px;
        flex-wrap:wrap;
        min-height:82px;
      }
      .hw-note {
        min-width:34px;
        padding:8px 6px;
        border:1px solid #99958a;
        background:#fff;
        font-size:12px;
        font-weight:900;
        position:relative;
      }
      .hw-note.first {
        border:2px solid #171717;
      }
      .hw-note.first::before {
        content:'1st';
        position:absolute;
        top:-17px;
        left:50%;
        transform:translateX(-50%);
        font-size:8px;
        letter-spacing:.05em;
        background:#171717;
        color:#fff;
        padding:2px 4px;
      }
      .hw-release {
        display:inline-block;
        margin-top:6px;
        padding:5px 8px;
        border-top:1px solid #aaa69a;
        font-size:10px;
        font-weight:900;
        letter-spacing:.05em;
      }
      .hw-result-card {
        min-height:98px;
        border:1px solid #aaa69a;
        background:#fff;
        padding:11px;
        text-align:left;
      }
      .hw-result-line {
        display:flex;
        justify-content:space-between;
        gap:10px;
        padding:5px 0;
        border-bottom:1px solid #ebe8df;
        font-size:11px;
      }
      .hw-result-line:last-child { border-bottom:0; }
      .hw-result-line strong { white-space:nowrap; }
      .hw-root-example {
        margin-top:16px;
        display:grid;
        grid-template-columns:1fr auto 1fr;
        gap:14px;
        align-items:center;
        padding:14px;
        background:#f7f6f1;
        border-radius:8px;
      }
      .hw-root-example .example {
        min-width:0;
      }
      .hw-root-example .example strong {
        display:block;
        margin-bottom:4px;
      }
      .hw-root-arrow {
        font-weight:900;
        font-size:20px;
      }
      .hw-language-key {
        margin-top:14px;
        display:flex;
        gap:16px;
        flex-wrap:wrap;
        align-items:center;
        font-size:11px;
        color:#5b574e;
      }
      .hw-language-key strong { color:#171717; }
      @media (max-width:900px) {
        .hw-flow { grid-template-columns:1fr; }
        .hw-stage {
          border-right:0;
          border-bottom:1px solid #d8d5ca;
        }
        .hw-stage:last-child { border-bottom:0; }
        .hw-stage::after {
          content:'↓';
          right:auto;
          left:50%;
          top:auto;
          bottom:-10px;
          transform:translateX(-50%);
        }
        .hw-root-example { grid-template-columns:1fr; }
        .hw-root-arrow { transform:rotate(90deg); justify-self:center; }
      }

      @media (max-width:800px) {
        main { padding:24px 12px 60px; }
        .card { padding:18px; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>SND SAM-16 Online Manual</h1>
      <p>Interactive documentation prototype.</p>

      <section class="card">
        <h2>Variable Timing + ALIGN</h2>
        <p class="note">
          In <strong>var.</strong> mode, <strong>Row 3</strong> sets the duration of each step.
          Turn a Row 3 knob fully clockwise to <strong>ALIGN</strong> and the SAM holds at that
          point until the end of the current measure. The global <strong>Align</strong> setting
          defines the length of that measure.
        </p>

        <div class="controls">
          <div>
            <label for="align">GLOBAL ALIGN — measure length</label>
            <div class="control-group">
              <select id="align">
                {Array.from({length:16}, (_,i) => <option value={i+1} selected={i===7}>{i+1}/8</option>)}
              </select>
            </div>
          </div>
          <div>
            <label>TRANSPORT</label>
            <div class="control-group">
              <button id="play">Play</button>
              <button id="reset">Reset</button>
            </div>
          </div>
        </div>

        <div class="hardware-caption">ROW 3 — step length in VAR mode</div>

        <div class="steps-wrap">
          <div class="steps" id="steps">
            {Array.from({length:16}, (_,i) => (
              <div class="step" data-step={i}>
                <div class="step-number">STEP {i+1}</div>
                <div
                  class="knob-shell"
                  role="slider"
                  tabindex="0"
                  aria-label={`Row 3 timing for step ${i+1}`}
                  aria-valuemin="0"
                  aria-valuemax="6"
                  aria-valuenow={i===7 ? "6" : "3"}
                  aria-valuetext={i===7 ? "ALIGN" : "1/8"}
                  data-index={i===7 ? "6" : "3"}
                >
                  {[-150,-120,-60,0,60,120,150].map(a => <i class="knob-dot" style={`--dot-angle:${a}deg`}></i>)}
                  <div class="knob" style="--angle:0deg"></div>
                </div>
                <div class="timing-value" aria-hidden="true">{i===7 ? "ALIGN" : "1/8"}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="explain-strip">
          <span><strong>Timeline:</strong></span>
          <span class="legend-chip"><span class="legend-swatch"></span> each numbered block = one SAM step</span>
          <span class="legend-chip"><span class="legend-swatch align"></span> ALIGN = wait to the next measure boundary</span>
        </div>

        <div class="timeline-shell">
          <div class="timeline-toolbar">
            <strong>WHAT THE SAM IS DOING OVER TIME</strong>
            <span id="measureInfo">Align = 8/8</span>
          </div>
          <div class="timeline-scroll" id="timelineScroll">
            <div class="timeline-stage" id="timelineStage" aria-label="SAM step timing over a fixed 16/8 window with straight reference grid">
              <div class="ruler" id="ruler"></div>
              <div class="sequence-track" id="sequenceTrack"></div>
              <div class="reference-track" id="referenceTrack">
                <span class="reference-label">STRAIGHT 16TH GRID</span>
              </div>
              <div class="playhead" id="playhead"></div>
            </div>
          </div>
          <div class="status" id="status">Stopped — Step 1</div>
        </div>

        <p class="microcopy">
          Drag a Row 3 knob up or down to move through its detents. The upper lane shows the SAM timing; the straight 16th grid underneath stays fixed. The display always covers 16/8. Changing Global Align moves only the measure boundaries unless a step is actually set to ALIGN.
        </p>
      </section>


      <section class="card" id="chordProgramming">
        <h2>Programming a Chord</h2>
        <p class="note">
          The SAM stores programmable notes and chords through a short hardware sequence:
          stop the machine, move <strong>Scale</strong> to <strong>PROGRAM</strong>, choose a memory position with
          the <strong>Step 1 Pitch selector</strong>, play the chord through MIDI In, then release the keys to store it.
        </p>

        <div class="hw-recipe">
          <div class="hw-recipe-head">
            <strong>HARDWARE RECIPE</strong>
            <span>Read left → right</span>
          </div>

          <div class="hw-flow">
            <div class="hw-stage">
              <div class="hw-kicker">Transport</div>
              <div class="hw-step-badge">STOP</div>
              <div class="hw-action">Stop the SAM</div>
              <div class="hw-detail">Programming is only available while stopped.</div>
            </div>

            <div class="hw-stage">
              <div class="hw-kicker">Scale switch</div>
              <div class="hw-toggle" aria-label="Scale switch in upper Program position">
                <div class="hw-toggle-track"></div>
                <i class="hw-toggle-pos up active"></i>
                <i class="hw-toggle-pos mid"></i>
                <i class="hw-toggle-pos down"></i>
                <i class="hw-toggle-lever"></i>
                <div class="hw-switch-labels">
                  <span class="up">PROGRAM</span>
                  <span class="mid">—</span>
                  <span class="down">—</span>
                </div>
              </div>
              <div class="hw-action">SCALE ↑ PROGRAM</div>
              <div class="hw-detail">Move the Scale toggle to its upper programming position.</div>
            </div>

            <div class="hw-stage">
              <div class="hw-kicker">Memory position</div>
              <div class="hw-step-badge">STEP 1</div>
              <div class="hw-mini-knob-shell" aria-label="Step 1 Pitch selector">
                <i class="hw-mini-dot"></i><i class="hw-mini-dot"></i><i class="hw-mini-dot"></i><i class="hw-mini-dot"></i>
                <i class="hw-mini-dot"></i><i class="hw-mini-dot"></i><i class="hw-mini-dot"></i><i class="hw-mini-dot"></i>
                <i class="hw-mini-dot"></i><i class="hw-mini-dot"></i><i class="hw-mini-dot"></i><i class="hw-mini-dot"></i>
                <div class="hw-mini-knob"></div>
              </div>
              <div class="hw-action">PITCH → choose 1 of 12 positions</div>
              <div class="hw-detail">Only the Step 1 Pitch selector chooses which programmable position you are editing.</div>
            </div>

            <div class="hw-stage">
              <div class="hw-kicker">MIDI In</div>
              <div class="hw-midi-notes" aria-label="Example chord entry order E, G, C">
                <span class="hw-note first">E</span>
                <span>→</span>
                <span class="hw-note">G</span>
                <span>→</span>
                <span class="hw-note">C</span>
              </div>
              <div class="hw-action">Play up to 7 notes</div>
              <div class="hw-release">RELEASE KEYS → STORE</div>
              <div class="hw-detail">The SAM provides software thru while you enter the chord.</div>
            </div>

            <div class="hw-stage">
              <div class="hw-kicker">Stored result</div>
              <div class="hw-result-card">
                <div class="hw-result-line"><span>Programmed chord</span><strong>C · E · G</strong></div>
                <div class="hw-result-line"><span>First-entered note</span><strong>E</strong></div>
                <div class="hw-result-line"><span>Pitch CV</span><strong>E</strong></div>
                <div class="hw-result-line"><span>Adjacent MIDI*</span><strong>E</strong></div>
              </div>
              <div class="hw-detail">* In Dual / X-fade modes.</div>
            </div>
          </div>
        </div>

        <div class="hw-root-example">
          <div class="example">
            <strong>Enter C first</strong>
            C → E → G &nbsp; = &nbsp; stored chord C–E–G<br />
            Monophonic / first-entered note: <strong>C</strong>
          </div>
          <div class="hw-root-arrow">↔</div>
          <div class="example">
            <strong>Enter E first</strong>
            E → G → C &nbsp; = &nbsp; stored chord C–E–G<br />
            Monophonic / first-entered note: <strong>E</strong>
          </div>
        </div>

        <div class="hw-language-key">
          <strong>Visual language:</strong>
          <span>black badge = machine/step state</span>
          <span>toggle drawing = physical switch position</span>
          <span>knob + STEP label = exact hardware control</span>
          <span>arrow = next physical action</span>
        </div>
      </section>


      <script is:inline>
        const eighthMs = 240;
        let pxPerEighth = 48;

        const viewEighths = 16;

        function horizonEighths() {
          return viewEighths;
        }
        const angleMap = {
          '0':'-150deg',
          '0.25':'-120deg',
          '0.5':'-60deg',
          '1':'0deg',
          '2':'60deg',
          '4':'120deg',
          '-1':'150deg'
        };

        const steps = [...document.querySelectorAll('.step')];
        const align = document.querySelector('#align');
        const ruler = document.querySelector('#ruler');
        const sequenceTrack = document.querySelector('#sequenceTrack');
        const stage = document.querySelector('#timelineStage');
        const playhead = document.querySelector('#playhead');
        const status = document.querySelector('#status');
        const measureInfo = document.querySelector('#measureInfo');
        const timelineScroll = document.querySelector('#timelineScroll');
        const referenceTrack = document.querySelector('#referenceTrack');

        let running = false;
        let timer = null;
        let stepIndex = 0;
        let pos = 0;
        let activeSegment = null;

        const timingOptions = [
          { label:'SKIP', value:0 },
          { label:'1/32', value:0.25 },
          { label:'1/16', value:0.5 },
          { label:'1/8', value:1 },
          { label:'1/4', value:2 },
          { label:'1/2', value:4 },
          { label:'ALIGN', value:-1 }
        ];

        function knobEl(stepEl) {
          return stepEl.querySelector('.knob-shell');
        }

        function currentIndex(stepEl) {
          return Number(knobEl(stepEl).dataset.index);
        }

        function currentValue(stepEl) {
          return timingOptions[currentIndex(stepEl)].value;
        }

        function setTimingIndex(stepEl, nextIndex, redrawTimeline = true) {
          const index = Math.max(0, Math.min(timingOptions.length - 1, nextIndex));
          const shell = knobEl(stepEl);
          const option = timingOptions[index];
          shell.dataset.index = String(index);
          shell.setAttribute('aria-valuenow', String(index));
          shell.setAttribute('aria-valuetext', option.label);
          stepEl.querySelector('.timing-value').textContent = option.label;
          refreshKnob(stepEl);
          if (redrawTimeline) renderSequence();
        }

        function nextBoundary(position, measureLength) {
          const remainder = position % measureLength;
          if (Math.abs(remainder) < 0.000001) return position + measureLength;
          return position + (measureLength - remainder);
        }

        function refreshKnob(step) {
          const value = String(currentValue(step));
          step.querySelector('.knob').style.setProperty('--angle', angleMap[value] || '0deg');
          step.classList.toggle('align-step', value === '-1');
        }

        function refreshKnobs() {
          steps.forEach(refreshKnob);
        }

        function renderRuler() {
          ruler.innerHTML = '';
          [...stage.querySelectorAll('.bar-band')].forEach(el => el.remove());

          const measure = Number(align.value);
          const horizon = horizonEighths();
          const available = Math.max(1, timelineScroll.clientWidth || stage.parentElement.clientWidth || 1);
          pxPerEighth = available / horizon;
          stage.style.width = '100%';
          measureInfo.textContent = `Fixed view: 16/8 · Align boundaries every ${measure}/8`;

          const measureCount = Math.ceil(horizon / measure);

          for (let bar = 0; bar < measureCount; bar++) {
            const start = bar * measure;
            const width = Math.min(measure, horizon - start);
            if (width <= 0) break;

            const band = document.createElement('div');
            band.className = 'bar-band' + (bar % 2 ? ' alt' : '');
            band.style.left = (start * pxPerEighth) + 'px';
            band.style.width = (width * pxPerEighth) + 'px';
            stage.insertBefore(band, ruler);
          }

          for (let i = 0; i <= horizon; i++) {
            const isMeasureBoundary = i % measure === 0;
            const line = document.createElement('div');
            line.className = isMeasureBoundary ? 'bar-line' : 'eighth-line';
            line.style.left = (i * pxPerEighth) + 'px';
            ruler.appendChild(line);

            if (isMeasureBoundary && i < horizon) {
              const measureNumber = Math.floor(i / measure) + 1;
              const label = document.createElement('div');
              label.className = 'bar-label';
              label.style.left = (i * pxPerEighth) + 'px';

              if (measure <= 2) {
                label.textContent = `M${measureNumber}`;
              } else if (measure <= 4) {
                label.innerHTML = `M${measureNumber}<span class="bar-length">· ${measure}/8</span>`;
              } else {
                label.innerHTML = `MEASURE ${measureNumber}<span class="bar-length">· ${measure}/8</span>`;
              }
              ruler.appendChild(label);
            }
          }
        }

        function computeSegments() {
          const measure = Number(align.value);
          const result = [];
          let p = 0;
          let index = 0;
          let safety = 0;

          const horizon = horizonEighths();
          while (p < horizon && safety < 256) {
            const stepEl = steps[index];
            const value = currentValue(stepEl);
            let duration = value;
            let type = 'normal';

            if (value === -1) {
              duration = nextBoundary(p, measure) - p;
              type = 'align';
            } else if (value === 0) {
              duration = 0;
              type = 'skip';
            }

            result.push({
              step: index + 1,
              start: p,
              duration,
              type
            });

            if (duration > 0) p += duration;
            index = (index + 1) % 16;
            safety++;
          }
          return result;
        }

        function renderReference() {
          [...referenceTrack.querySelectorAll('.beat-pulse')].forEach(el => el.remove());
          const horizon = horizonEighths();
          const measure = Number(align.value);
          const sixteenthCount = Math.round(horizon * 2);

          for (let i = 0; i <= sixteenthCount; i++) {
            const p = i / 2;
            const pulse = document.createElement('i');
            const isDownbeat = Math.abs(p % measure) < 0.000001;
            const isQuarter = i % 2 === 0;
            pulse.className = 'beat-pulse' + (isQuarter ? ' quarter' : '') + (isDownbeat ? ' downbeat' : '');
            pulse.style.left = (p * pxPerEighth) + 'px';
            referenceTrack.appendChild(pulse);
          }
        }

        function renderSequence() {
          sequenceTrack.innerHTML = '';
          const segments = computeSegments();

          segments.forEach((seg, i) => {
            const block = document.createElement('div');
            block.className = 'segment ' + seg.type;
            block.dataset.segment = String(i);
            block.dataset.step = String(seg.step - 1);
            block.style.left = (seg.start * pxPerEighth) + 'px';

            if (seg.type === 'skip') {
              block.style.width = '3px';
              block.title = `Step ${seg.step}: SKIP`;
            } else {
              block.style.width = Math.max(4, seg.duration * pxPerEighth - 2) + 'px';
              block.textContent = seg.type === 'align' ? `${seg.step} · ALIGN` : String(seg.step);
              block.title = seg.type === 'align'
                ? `Step ${seg.step}: ALIGN hold ${seg.duration}/8 until measure boundary`
                : `Step ${seg.step}: ${seg.duration}/8`;
            }
            sequenceTrack.appendChild(block);
          });
        }

        function redraw() {
          refreshKnobs();
          renderRuler();
          renderSequence();
          renderReference();
        }

        function clearActive() {
          steps.forEach(s => s.classList.remove('active'));
          if (activeSegment) activeSegment.classList.remove('active');
          activeSegment = null;
        }

        function findSegmentAt(step, startPos) {
          const segments = [...sequenceTrack.querySelectorAll('.segment')];
          return segments.find(el => {
            const left = parseFloat(el.style.left) / pxPerEighth;
            return Number(el.dataset.step) === step && Math.abs(left - startPos) < 0.001;
          }) || null;
        }

        function advance() {
          if (!running) return;

          clearActive();
          const stepEl = steps[stepIndex];
          stepEl.classList.add('active');

          const value = currentValue(stepEl);
          const measure = Number(align.value);
          const startPos = pos;
          let duration = value;
          let description = '';

          if (value === -1) {
            duration = nextBoundary(pos, measure) - pos;
            description = `Step ${stepIndex + 1}: ALIGN — wait ${duration}/8 until the next measure boundary`;
          } else if (value === 0) {
            duration = 0;
            description = `Step ${stepIndex + 1}: SKIP`;
          } else {
            description = `Step ${stepIndex + 1}: ${timingOptions[currentIndex(stepEl)].label}`;
          }

          const horizon = horizonEighths();
          activeSegment = findSegmentAt(stepIndex, startPos % horizon);
          if (activeSegment) activeSegment.classList.add('active');

          status.textContent = description;

          if (duration > 0) {
            const nextPos = pos + duration;
            const reachesWindowEnd = nextPos >= horizon - 0.000001;

            if (reachesWindowEnd) {
              pos = horizon;
              playhead.style.left = (horizon * pxPerEighth) + 'px';

              const nextHardwareStep = (stepIndex + 1) % 16;
              const delay = Math.max(90, duration * eighthMs);
              timer = setTimeout(() => {
                running = false;
                clearActive();
                document.querySelector('#play').textContent = 'Play';
                status.textContent = `End of fixed 16/8 view — SAM continues with Step ${nextHardwareStep + 1}`;
              }, delay);
              return;
            }

            pos = nextPos;
            playhead.style.left = (pos * pxPerEighth) + 'px';
          }

          stepIndex = (stepIndex + 1) % 16;
          timer = setTimeout(advance, Math.max(90, duration > 0 ? duration * eighthMs : 90));
        }

        document.querySelector('#play').onclick = () => {
          running = !running;
          document.querySelector('#play').textContent = running ? 'Pause' : 'Play';
          if (running) advance();
          else clearTimeout(timer);
        };

        function resetTransport(message = 'Stopped — Step 1') {
          running = false;
          clearTimeout(timer);
          clearActive();
          stepIndex = 0;
          pos = 0;
          playhead.style.left = '0px';
          timelineScroll.scrollLeft = 0;
          status.textContent = message;
          document.querySelector('#play').textContent = 'Play';
        }

        document.querySelector('#reset').onclick = () => {
          resetTransport();
        };

        function applyAlignChange() {
          const measure = Number(align.value);
          resetTransport(`Align = ${measure}/8 — fixed 16/8 view. Row 3 step lengths are unchanged; only Align boundaries move unless a step uses ALIGN.`);
          redraw();
        }

        align.addEventListener('input', applyAlignChange);
        align.addEventListener('change', applyAlignChange);

        steps.forEach(step => {
          const shell = knobEl(step);
          let startY = 0;
          let startIndex = 0;
          let movedIndex = 0;

          shell.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            resetTransport();
            shell.setPointerCapture(event.pointerId);
            shell.classList.add('dragging');
            startY = event.clientY;
            startIndex = currentIndex(step);
            movedIndex = startIndex;
            shell.focus();
          });

          shell.addEventListener('pointermove', (event) => {
            if (!shell.hasPointerCapture(event.pointerId)) return;
            const delta = startY - event.clientY;
            const detents = Math.round(delta / 18);
            const nextIndex = Math.max(0, Math.min(6, startIndex + detents));
            if (nextIndex !== movedIndex) {
              movedIndex = nextIndex;
              setTimingIndex(step, nextIndex);
            }
          });

          const endDrag = (event) => {
            if (shell.hasPointerCapture(event.pointerId)) shell.releasePointerCapture(event.pointerId);
            shell.classList.remove('dragging');
          };
          shell.addEventListener('pointerup', endDrag);
          shell.addEventListener('pointercancel', endDrag);

          shell.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowUp' || event.key === 'ArrowRight') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, currentIndex(step) + 1);
            } else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, currentIndex(step) - 1);
            } else if (event.key === 'Home') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, 0);
            } else if (event.key === 'End') {
              event.preventDefault();
              resetTransport();
              setTimingIndex(step, 6);
            }
          });

          shell.addEventListener('wheel', (event) => {
            event.preventDefault();
            resetTransport();
            setTimingIndex(step, currentIndex(step) + (event.deltaY < 0 ? 1 : -1));
          }, { passive:false });
        });



        }

        function refreshChordProgramState() {
          chordProgram.classList.toggle('active', chordProgramMode);
          chordProgram.textContent = chordProgramMode ? 'SCALE → PROGRAM ✓' : 'SCALE → PROGRAM';
          const writable = chordTransportStopped && chordProgramMode;

          midiKeys.forEach(key => key.disabled = !writable);
          if (!writable) heldOrder = [];

          if (!chordTransportStopped) {
            programInstruction.textContent = 'RUNNING — PROGRAM cannot be selected. Stop the SAM first.';
          } else if (!chordProgramMode) {
            programInstruction.textContent = 'STOPPED — now move the Scale switch to PROGRAM.';
          } else {
            programInstruction.textContent = 'PROGRAM active — Step 1 Pitch selects the memory position. Select up to seven MIDI notes, then release/store them.';
          }
          programInstruction.classList.toggle('locked', !writable);
          refreshHeldNotes();
        }

        function setPitchSlot(index) {
          selectedPitchSlot = Math.max(0, Math.min(11, index));
          const angle = -150 + selectedPitchSlot * (300 / 11);
          pitchProgramKnob.querySelector('.pitch-program-knob').style.setProperty('--slot-angle', angle + 'deg');
          pitchProgramKnob.setAttribute('aria-valuenow', String(selectedPitchSlot + 1));
          pitchSlotReadout.textContent = String(selectedPitchSlot + 1) + ' / 12';
          pitchSlotButtons.forEach((button,i) => button.classList.toggle('active', i === selectedPitchSlot));
          refreshStoredSlot();
        }

        function refreshStoredSlot() {
          const slot = chordSlots[selectedPitchSlot];
          pitchSlotStored.textContent = slot.notes.length ? chordText(slot.notes) + ' · root ' + slot.root : 'empty';

          pitchSlotButtons.forEach((button,i) => {
            button.classList.toggle('has-chord', chordSlots[i].notes.length > 0);
            button.title = chordSlots[i].notes.length
              ? 'Position ' + (i+1) + ': ' + chordText(chordSlots[i].notes) + ' · root ' + chordSlots[i].root
              : 'Position ' + (i+1) + ': empty';
          });

          baseChordOutput.textContent = chordText(slot.notes);
          pitchCvOutput.textContent = slot.root || '—';
          adjacentOutput.textContent = slot.root || '—';

          if (slot.notes.length) {
            rootExplainer.innerHTML = 'Stored position <strong>' + (selectedPitchSlot + 1) + '</strong>: full chord <strong>' + chordText(slot.notes) + '</strong>; first-entered/root note <strong>' + slot.root + '</strong>.';
          } else {
            rootExplainer.textContent = 'This position is empty. Enter PROGRAM, select notes, then use “Release keys → Store”.';
          }
        }

        function refreshHeldNotes() {
          midiKeys.forEach(key => {
            const note = key.dataset.note;
            key.classList.toggle('held', heldOrder.includes(note));
            key.classList.toggle('root-key', heldOrder[0] === note);
          });

          if (!heldOrder.length) {
            heldNotesEl.innerHTML = '<span>No MIDI notes held.</span>';
          } else {
            heldNotesEl.innerHTML = heldOrder.map((note,i) => '<span class="note-chip ' + (i===0 ? 'root' : '') + '">' + note + (i===0 ? ' · 1st/root' : '') + '</span>').join('');
          }

          const writable = chordTransportStopped && chordProgramMode;
          storeChordBtn.disabled = !writable || heldOrder.length === 0;
          clearHeldBtn.disabled = !writable || heldOrder.length === 0;
        }

        chordStop.addEventListener('click', () => setChordTransport(true));
        chordRun.addEventListener('click', () => setChordTransport(false));

        chordProgram.addEventListener('click', () => {
          if (!chordTransportStopped) {
            refreshChordProgramState();
            return;
          }
          chordProgramMode = !chordProgramMode;
          refreshChordProgramState();
        });

        pitchSlotButtons.forEach((button,i) => button.addEventListener('click', () => setPitchSlot(i)));

        pitchProgramKnob.addEventListener('wheel', event => {
          event.preventDefault();
          setPitchSlot(selectedPitchSlot + (event.deltaY < 0 ? 1 : -1));
        }, {passive:false});

        pitchProgramKnob.addEventListener('keydown', event => {
          if (event.key === 'ArrowUp' || event.key === 'ArrowRight') {
            event.preventDefault();
            setPitchSlot(selectedPitchSlot + 1);
          } else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
            event.preventDefault();
            setPitchSlot(selectedPitchSlot - 1);
          } else if (event.key === 'Home') {
            event.preventDefault();
            setPitchSlot(0);
          } else if (event.key === 'End') {
            event.preventDefault();
            setPitchSlot(11);
          }
        });

        midiKeys.forEach(key => {
          key.addEventListener('click', () => {
            if (!chordTransportStopped || !chordProgramMode) return;
            const note = key.dataset.note;
            const existing = heldOrder.indexOf(note);
            if (existing >= 0) {
              heldOrder.splice(existing, 1);
            } else if (heldOrder.length < 7) {
              heldOrder.push(note);
            }
            refreshHeldNotes();
          });
        });

        clearHeldBtn.addEventListener('click', () => {
          heldOrder = [];
          refreshHeldNotes();
        });

        storeChordBtn.addEventListener('click', () => {
          if (!heldOrder.length || !chordTransportStopped || !chordProgramMode) return;

          const root = heldOrder[0];
          const notes = chordSort(heldOrder);
          chordSlots[selectedPitchSlot] = {notes:notes, root:root};

          const storedChord = chordText(notes);
          heldOrder = [];
          refreshHeldNotes();
          refreshStoredSlot();
          rootExplainer.innerHTML = 'Released/stored: <strong>' + storedChord + '</strong>. Because <strong>' + root + '</strong> was entered first, the monophonic/root output is <strong>' + root + '</strong>.';
        });

        setPitchSlot(0);
        refreshChordProgramState();


        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(redraw, 120);
        });

        redraw();
      </script>
    </main>
  </body>
</html>
